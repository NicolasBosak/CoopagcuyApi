{
  "rules": [
    {
      "enabled": true,
      "name": "borrar-evidencias-clinicas-90d",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": [ "blockBlob" ],
          "prefixMatch": [ "evidencias-clinicas/" ]
        },
        "actions": {
          "baseBlob": {
            "delete": { "daysAfterCreationGreaterThan": 90 }
          }
        }
      }
    },
    {
      "enabled": true,
      "name": "borrar-comprobantes-pago-30d",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": [ "blockBlob" ],
          "prefixMatch": [ "comprobantes-pago/" ]
        },
        "actions": {
          "baseBlob": {
            "delete": { "daysAfterCreationGreaterThan": 30 }
          }
        }
      }
    }
  ]
}
